# Copy this file to deployment/mongo.env and replace the password before starting Compose.
# The real deployment/mongo.env file is ignored by git.

MONGO_INITDB_ROOT_USERNAME=flowcept
MONGO_INITDB_ROOT_PASSWORD=change-this-password
MONGO_INITDB_DATABASE=flowcept

# Use this from the host when running Flowcept outside Docker Compose.
MONGO_URI=mongodb://flowcept:change-this-password@localhost:27017/flowcept?authSource=admin

# Use this form from another container on the same Compose network.
# MONGO_URI=mongodb://flowcept:change-this-password@flowcept_mongo:27017/flowcept?authSource=admin
